# Replaces ios/Podfile from `@react-native-community/cli init` (RN 0.87.1). Two changes:
# 1. Dynamic frameworks: @react-native-firebase 26 resolves the Firebase iOS SDK through Swift
#    Package Manager, which needs dynamic linkage.
# 2. RNCClipboard links CoreServices: with the iOS 27 SDK, MobileCoreServices no longer brings in
#    the UTType C functions the clipboard module calls, and its dynamic framework fails to link.

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :dynamic

target 'barepushtest' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      next unless target.name == 'RNCClipboard'
      target.build_configurations.each do |build_config|
        build_config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -framework CoreServices'
      end
    end
  end
end
