# Public key of the project, from the dashboard (Project -> API keys). Never use a secret key (sk_) here:
# it would be shipped to every visitor of the page.
VITE_ESPRESSO_PROJECT_ID=pk_live_xxxxxxxxxxxxxxxx

# Base URL of the Espresso Notify API the SDK talks to. It is compiled into the SDK and into the
# service worker by `npm run prepare:sdk` (run before `dev` and `build`).
# Production: https://api.espressonotify.com    Local API: http://localhost:8080
VITE_ESPRESSO_API_URL=https://api.espressonotify.com
