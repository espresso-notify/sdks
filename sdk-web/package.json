{
  "name": "@espresso-notify/web",
  "version": "0.0.3",
  "description": "Web push notifications for websites and PWAs in Chrome, Firefox, Edge and Safari, with VAPID keys, one API and a dashboard.",
  "keywords": [
    "web-push",
    "web-push-notifications",
    "push-notifications",
    "push",
    "notifications",
    "browser-notifications",
    "service-worker",
    "pwa",
    "vapid",
    "javascript",
    "typescript",
    "chrome",
    "firefox",
    "safari",
    "edge",
    "onesignal-alternative",
    "espresso-notify",
    "sdk"
  ],
  "author": {
    "name": "Caffeee Labs",
    "url": "https://espressonotify.com"
  },
  "contributors": [
    {
      "name": "Andrey Passos",
      "url": "https://www.npmjs.com/~caffeee"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espresso-notify/sdks.git",
    "directory": "sdk-web"
  },
  "bugs": {
    "url": "https://github.com/espresso-notify/sdks/issues"
  },
  "homepage": "https://docs.espressonotify.com/docs/sdks/web",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sw.js": "./dist/sw.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "espresso-notify-web": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/sw.js",
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.sw.json && node inject-url.mjs",
    "build:sw": "tsc -p tsconfig.sw.json && node inject-url.mjs",
    "test": "jest",
    "verify:dist": "node ../scripts/verify-dist.mjs .",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepack": "node ../scripts/verify-dist.mjs --no-placeholder .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
